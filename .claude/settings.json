{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "PowerShell(uv run pytest*)",
      "Bash(uv run ruff*)",
      "PowerShell(uv run ruff*)",
      "Bash(python -X utf8 diagnostics/*)",
      "PowerShell(python -X utf8 diagnostics/*)",
      "Bash(git status*)",
      "PowerShell(git status*)",
      "Bash(git diff*)",
      "PowerShell(git diff*)",
      "Bash(git log*)",
      "PowerShell(git log*)"
    ],
    "ask": [
      "Bash(git push*)",
      "PowerShell(git push*)",
      "Bash(uv add*)",
      "PowerShell(uv add*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(../secret/**)",
      "Edit(../secret/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(rm -rf*)",
      "PowerShell(Remove-Item*-Recurse*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.js"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/tools/roadmap.py",
              "brief"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/tools/roadmap.py",
              "check"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}