# 이 파일을 같은 폴더에 secrets.toml 로 복사해 채운다.
#
#   copy .streamlit\secrets.toml.template .streamlit\secrets.toml
#
# secrets.toml 은 .gitignore 에 있어 커밋되지 않는다. 절대 저장소에 올리지 않는다.
# 코드에서는 st.secrets 를 직접 읽지 않고 config.settings.secrets 를 쓴다.
#
# 사외망 작업본에서는 전부 비워 둔 채로 앱이 떠야 한다 (비어 있는 것이 정상).

# LLM — modules/llm_client.py 가 쓴다. 갈래가 둘이고 llm_provider 가 가른다.
#
#   비움 / "inhouse"  사내 게이트웨이 (사내망 고정본. SPEC.md §11)
#   "openai"          OpenAI API  — **공개 데모 전용** (CLAUDE.md §3·§6-9 의 예외)
#   "claude"          Anthropic API — 같은 예외
#
# 비워 두면 앱은 「직접 적기」로 돈다 — 그것이 정상 상태다.
llm_provider = ""

# 사내 갈래
llm_base_url = ""

# 둘 다 쓰는 것
llm_model = ""      # 비우면 갈래 기본값 (openai → gpt-4o-mini, claude → claude-sonnet-5-5)
llm_api_key = ""    # 절대 저장소에 올리지 않는다

[db]
# 비우면 config.paths.db_url() (data/meeting.db) 를 쓴다.
# 사내망에서 다른 DB 로 갈 때만 채운다.
url = ""
